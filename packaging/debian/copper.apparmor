# AppArmor profile for Copper (installed by the copper .deb as
# /etc/apparmor.d/copper and loaded by its postinst).
#
# Ubuntu 23.10+ sets kernel.apparmor_restrict_unprivileged_userns=1, which
# stops WebKitGTK's bubblewrap web-process sandbox from creating the user
# namespace it needs ("bwrap: setting up uid map: Permission denied", then the
# web process aborts). This profile confines nothing (unconfined) and only
# grants `userns`, the same shape as Ubuntu's own /etc/apparmor.d/epiphany.
# Never work around it with WEBKIT_DISABLE_SANDBOX_THIS_IS_DANGEROUS.

abi <abi/4.0>,
include <tunables/global>

profile copper /usr/bin/copper flags=(unconfined) {
  userns,

  # Site-specific additions and overrides. See local/README for details.
  include if exists <local/copper>
}
