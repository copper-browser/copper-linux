  "settings": {
    "greeting": { "type": "string", "default": "Hello from the addon’s settings", "title": "Greeting" },
    "accent": { "type": "string", "default": "#b4532a", "title": "Accent colour" }
  },
  "platforms": ["mac", "linux", "windows"]
}
