def vault_ref(st, vid):
    for v in st.data["vaults"]:
        if v["id"] == vid:
            return {"id": v["id"], "name": v["name"]}
    return {"id": vid, "name": ""}


def find_vault(st, query, pool):
    for v in pool:
        if query and (v["id"] == query or v["name"].lower() == query.lower()):
            return v
    return None


def totp_code(uri):
    secret, digits, period = uri, 6, 30
    if uri.lower().startswith("otpauth://"):
        q = urllib.parse.parse_qs(urllib.parse.urlparse(uri).query)
        secret = q.get("secret", [""])[0]
        digits = int(q.get("digits", ["6"])[0])
        period = int(q.get("period", ["30"])[0])
    import base64
    s = secret.upper().replace(" ", "").replace("=", "")
    key = base64.b32decode(s + "=" * (-len(s) % 8))
    counter = struct.pack(">Q", int(time.time() // period))
    mac = hmac.new(key, counter, hashlib.sha1).digest()
    o = mac[-1] & 0x0F
    code = (struct.unpack(">I", mac[o:o + 4])[0] & 0x7FFFFFFF) % (10 ** digits)
    return str(code).zfill(digits)


def summary(st, item):
    out = {k: item[k] for k in ("id", "title", "version") if k in item}
    out["vault"] = vault_ref(st, item["vault"]["id"])
    for k in ("category", "last_edited_by", "created_at", "updated_at", "additional_information", "tags", "urls"):
        if k in item:
            out[k] = item[k]
    return out


def full(st, item, reveal):
    out = summary(st, item)
    if "sections" in item:
        out["sections"] = item["sections"]
    fields = []
    for f in item.get("fields", []):
        f = dict(f)
        f["reference"] = f"op://{out['vault']['name']}/{item['title']}/{f['label']}"
        if f["type"] == "OTP" and f.get("value"):
            try:
                f["totp"] = totp_code(f["value"])
            except Exception:
                pass
        if f["type"] in ("CONCEALED", "OTP") and not reveal and f.get("value"):
            f["value"] = f"[use 'op item get {item['id']} --reveal' to reveal]"
        fields.append(f)
    out["fields"] = fields
    return out


def visible_items(st, principal):
    ids = {v["id"] for v in principal.vaults(st)}
    return [i for i in st.data["items"] if i["vault"]["id"] in ids]


def find_item(st, principal, spec, vault=None):
    pool = visible_items(st, principal)
    if vault:
        v = find_vault(st, vault, principal.vaults(st))
        pool = [i for i in pool if v and i["vault"]["id"] == v["id"]]
    for i in pool:
        if i["id"] == spec:
            return i
    named = [i for i in pool if i["title"].lower() == str(spec).lower()]
    if len(named) == 1:
        return named[0]
    if len(named) > 1:
        fail(f'More than one item matches "{spec}". Try again and specify the item by its ID')
    fail(f'"{spec}" isn\'t an item. Specify the item with its ID, name, or domain.')


def specs_from_stdin():
    raw = read_stdin()
    text = raw.strip()
    if not text:
        return []
    specs = []
    try:
        data = json.loads(text)
        data = data if isinstance(data, list) else [data]
        for d in data:
            if isinstance(d, dict) and d.get("id"):
                specs.append((d["id"], (d.get("vault") or {}).get("id")))
        return specs
    except json.JSONDecodeError:
        pass
    decoder, pos = json.JSONDecoder(), 0
    try:
        while pos < len(text):
            while pos < len(text) and text[pos].isspace():
                pos += 1
            if pos >= len(text):
                break
            obj, pos = decoder.raw_decode(text, pos)
            if isinstance(obj, dict) and obj.get("id"):
                specs.append((obj["id"], (obj.get("vault") or {}).get("id")))
        return specs
    except json.JSONDecodeError:
        return [(line.strip(), None) for line in text.splitlines() if line.strip()]


def template_fields(template, existing=None):
    fields = []
    for f in template.get("fields", []):
        f = {k: v for k, v in f.items() if k not in ("reference", "totp", "entropy", "password_details")}
        f.setdefault("id", (f.get("label") or new_id()).replace(" ", "_"))
        f.setdefault("label", f["id"])
        f.setdefault("type", "STRING")
        if isinstance(f.get("value"), str) and f["value"].startswith("[use 'op item get"):
            old = next((o for o in (existing or []) if o.get("id") == f["id"]), None)
            f["value"] = old.get("value", "") if old else ""
        fields.append(f)
    return fields


def username_of(fields):
    for f in fields:
        if f.get("purpose") == "USERNAME":
            return f.get("value", "")
    return ""


# ---------------------------------------------------------------- commands

def cmd_account(st, flags, args):
    sub = args[0] if args else ""
    if sub in ("list", "ls"):
        accounts = [public_account(a) for a in st.data["accounts"]]
        if as_json(flags):
            emit(accounts)
        else:
            print("URL                          EMAIL                 USER ID")
            for a in accounts:
                print(f"{a['url'].replace('https://', ''):<28} {a['email']:<21} {a['user_uuid']}")
        return
    if sub == "add":
        address = (flags.get("--address") or "").lower().replace("https://", "").rstrip("/")
        email = (flags.get("--email") or "").lower()
        if not address or "." not in address or address.endswith(".invalid"):
            fail("Can't sign in. Enter your full sign-in address.")
        key = os.environ.get("OP_SECRET_KEY")
        if not key:
            fail("missing OP_SECRET_KEY environment variable")
        password = read_password(f"Enter the password for {email} at {address}: ")
        remote = None
        for a in st.data["remote_accounts"] + st.data["accounts"]:
            if a["email"].lower() == email and a["url"].replace("https://", "") == address:
                remote = a
        if not remote or remote["secret_key"] != key or remote["password"] != password:
            fail("Couldn't sign in. Check your sign-in details then try again.")
        if not find_account(st, remote["user_uuid"]):
            st.data["accounts"].append(remote)
            st.data["remote_accounts"] = [a for a in st.data["remote_accounts"] if a is not remote]
        st.save()
        if flags.get("--signin"):
            print_session(flags, remote, new_session(st, remote))
        return
    if sub == "forget":
        a = find_account(st, args[1] if len(args) > 1 else "")
        if a:
            st.data["accounts"].remove(a)
            st.save()
        return
    fail(f"unknown command \"{sub}\" for \"op account\"")


def cmd_signin(st, flags):
    if st.data["flags"].get("app_integration"):
        account = chosen_account(st, flags)
        delay = st.data["flags"].get("app_delay_ms", 0)
        if delay:
            time.sleep(delay / 1000)
        if not st.data["flags"].get("app_approve", True):
            fail("authorization prompt dismissed, please try again")
        st.data["app_sessions"][account["user_uuid"]] = True
        st.data["latest_signin"] = account["shorthand"]
        st.save()
        return
    account = chosen_account(st, flags)
    host = urllib.parse.urlparse(account["url"]).netloc
    password = read_password(f"Enter the password for {account['email']} at {host}: ")
    if password != account["password"]:
        fail("Authentication: (401) Unauthorized, You aren't authorized to perform this action.")
    print_session(flags, account, new_session(st, account))


def cmd_signout(st, flags):
    token = os.environ.get("OP_SERVICE_ACCOUNT_TOKEN")
    if token:
        return
    account = chosen_account(st, flags, required=False)
    if not account:
        return
    for key, s in list(st.data["sessions"].items()):
        if s["user_uuid"] == account["user_uuid"] or flags.get("--all"):
            s["expired"] = True
    st.data["app_sessions"][account["user_uuid"]] = False
    if flags.get("--forget"):
        st.data["accounts"] = [a for a in st.data["accounts"] if a["user_uuid"] != account["user_uuid"]]
    st.save()


def cmd_whoami(st, flags):
    p = authenticate(st, flags, "whoami")
    if p.kind == "service":
        out = {"url": "https://mock.1password.com", "user_uuid": pad("MOCKSERVICE", True),
               "account_uuid": pad("MOCKACCOUNTA", True), "user_type": "SERVICE_ACCOUNT"}
