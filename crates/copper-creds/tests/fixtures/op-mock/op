# ---------------------------------------------------------------- state

def state_path():
    path = os.environ.get("OP_MOCK_STATE")
    if not path:
        path = os.path.join(os.path.expanduser("~"), ".config", "op-mock", "state.json")
    return os.path.abspath(os.path.expanduser(path))


class State:
    def __enter__(self):
        path = state_path()
        os.makedirs(os.path.dirname(path), mode=0o700, exist_ok=True)
        self.lock = open(path + ".lock", "a+")
        fcntl.flock(self.lock, fcntl.LOCK_EX)
        self.path = path
        if os.path.exists(path):
            with open(path) as f:
                self.data = json.load(f)
        else:
            self.data = seed()
        self.dirty = not os.path.exists(path)
        return self

    def save(self):
        self.dirty = True

    def __exit__(self, *exc):
        if self.dirty:
            tmp = self.path + ".tmp"
            fd = os.open(tmp, os.O_WRONLY | os.O_CREAT | os.O_TRUNC, 0o600)
            with os.fdopen(fd, "w") as f:
                json.dump(self.data, f, indent=1)
            os.replace(tmp, self.path)
        fcntl.flock(self.lock, fcntl.LOCK_UN)
        self.lock.close()
        return False


def log_call(argv, stdin_len):
    try:
        path = os.path.join(os.path.dirname(state_path()), "calls.log")
        names = sorted(k for k in os.environ if k.startswith("OP_") and k != "OP_MOCK_STATE")
        with open(path, "a") as f:
            f.write(json.dumps({"t": now_iso(), "argv": argv, "op_env": names, "stdin_bytes": stdin_len}) + "\n")
    except OSError:
        pass


# ---------------------------------------------------------------- argv

VALUE_FLAGS = {"--account", "--format", "--session", "--vault", "--categories", "--permission", "--address",
               "--email", "--shorthand", "--title", "--url", "--category", "--tags", "--fields", "--config",
               "--encoding", "--cache", "--generate-password", "--template", "--group", "--user", "--out-file"}


def parse(argv):
    flags, positional = {}, []
    i = 0
    while i < len(argv):
        a = argv[i]
        if a.startswith("--") and "=" in a:
            k, v = a.split("=", 1)
            flags[k] = v
        elif a in VALUE_FLAGS:
            flags[a] = argv[i + 1] if i + 1 < len(argv) else ""
            i += 1
        elif a.startswith("--") or a in ("-h", "-f", "-v"):
            flags[a] = True
        else:
            positional.append(a)
        i += 1
    return flags, positional


def as_json(flags):
    return flags.get("--format", os.environ.get("OP_FORMAT", "")) == "json"


MALFORMED = False


def emit(obj):
    text = json.dumps(obj, indent=2) + "\n"
    if MALFORMED:
        text = text[: len(text) // 2] + "\n<<garbage>> }}} ]\n"
    sys.stdout.write(text)


# ---------------------------------------------------------------- auth

def public_account(a):
    return {k: a[k] for k in ("url", "email", "user_uuid", "account_uuid", "shorthand")}


def find_account(st, query):
    q = (query or "").lower()
    for a in st.data["accounts"]:
        host = urllib.parse.urlparse(a["url"]).netloc.lower()
        if q in (a["user_uuid"].lower(), a["shorthand"].lower(), a["email"].lower(), host, a["url"].lower(),
                 a["account_uuid"].lower()):
            return a
    return None


def chosen_account(st, flags, required=True):
    query = flags.get("--account") or os.environ.get("OP_ACCOUNT")
    if query:
        a = find_account(st, query)
        if not a:
            fail(f"no account found for filter {query}")
        return a
    if st.data.get("latest_signin"):
        a = find_account(st, st.data["latest_signin"])
        if a:
            return a
    if len(st.data["accounts"]) == 1:
        return st.data["accounts"][0]
    if not st.data["accounts"]:
        if required:
            fail("No accounts configured for use with 1Password CLI.")
        return None
    if required:
        fail("multiple accounts found; use the --account flag to choose one")
    return None


class Principal:
    def __init__(self, kind, account=None, token=None, spec=None):
        self.kind, self.account, self.token, self.spec = kind, account, token, spec

    def vaults(self, st):
        if self.kind == "service":
            return [v for v in st.data["vaults"] if v["id"] in self.spec["vaults"]]
        return list(st.data["vaults"])

    def writable(self, st):
        if self.kind == "service":
            return [v for v in st.data["vaults"] if v["id"] in self.spec["writable"]]
        return list(st.data["vaults"])


def authenticate(st, flags, command):
    token = os.environ.get("OP_SERVICE_ACCOUNT_TOKEN")
    if token:
        spec = st.data["service_tokens"].get(token)
        if not spec or spec.get("revoked"):
            fail("failed to DecodeSACredentials: invalid service account token")
        return Principal("service", token=token, spec=spec)
    account = chosen_account(st, flags)
    session = flags.get("--session") or os.environ.get("OP_SESSION_" + account["user_uuid"])
    if session:
        known = st.data["sessions"].get(session)
        if not known or known["user_uuid"] != account["user_uuid"]:
            fail("You are not currently signed in. Please run `op signin --help` for instructions")
        if known.get("expired") or time.time() - known.get("last", 0) > 30 * 60:
            known["expired"] = True
            st.save()
            fail("session expired, sign in to create a new session")
        known["last"] = time.time()
        st.save()
        return Principal("human", account=account)
    if st.data["flags"].get("app_integration"):
        if st.data["app_sessions"].get(account["user_uuid"]):
            return Principal("human", account=account)
        if command == "whoami":
            fail("account is not signed in")
        if not st.data["flags"].get("app_approve", True):
            fail("authorization prompt dismissed, please try again")
        st.data["app_sessions"][account["user_uuid"]] = True
        st.save()
        return Principal("human", account=account)
    if command == "whoami":
        fail(f"no active session found for account {account['shorthand']}")
    fail("You are not currently signed in. Please run `op signin --help` for instructions")


def read_stdin(gap=2.0, cap=20.0):
    """stdin, without ever hanging: nothing from a terminal, and from a pipe
    only what arrives — a pipe nobody writes to or closes (a harness's
    inherited stdin) gives up after `gap` seconds of silence."""
    try:
        if sys.stdin is None or sys.stdin.closed or sys.stdin.isatty():
            return ""
        fd = sys.stdin.fileno()
    except (OSError, ValueError):
        return ""
    import select
    chunks, started = [], time.time()
    while time.time() - started < cap:
        ready, _, _ = select.select([fd], [], [], gap)
        if not ready:
            break
        block = os.read(fd, 65536)
        if not block:
            break
        chunks.append(block)
    return b"".join(chunks).decode("utf-8", "replace")


def read_password(prompt):
    data = read_stdin()
    line = data.split("\n", 1)[0] if data else ""
    if not line:
        sys.stderr.write(prompt)
        fail("operation not supported by device")
    return line


def new_session(st, account):
    token = secrets.token_urlsafe(32)
    st.data["sessions"][token] = {"user_uuid": account["user_uuid"], "expired": False, "last": time.time()}
    st.data["latest_signin"] = account["shorthand"]
    st.save()
    return token


def print_session(flags, account, token):
    if flags.get("--raw"):
        sys.stdout.write(token + "\n")
    else:
        sys.stdout.write(f'export OP_SESSION_{account["user_uuid"]}="{token}"\n'
                         "# This command is meant to be used with your shell's eval function.\n")


