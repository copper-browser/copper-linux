def new_id():
    alphabet = "abcdefghijklmnopqrstuvwxyz234567"
    return "".join(secrets.choice(alphabet) for _ in range(26))


def pad(prefix, upper=False):
    value = (prefix + "0" * 26)[:26]
    return value.upper() if upper else value.lower()


