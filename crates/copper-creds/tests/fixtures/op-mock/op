        a = p.account
        out = {"url": a["url"], "email": a["email"], "user_uuid": a["user_uuid"],
               "account_uuid": a["account_uuid"], "user_type": "HUMAN"}
    if as_json(flags):
        emit(out)
    else:
        for k, v in out.items():
            print(f"{k.replace('_', ' ').title()}: {v}")


def cmd_vault(st, flags, args):
    if not args or args[0] not in ("list", "ls"):
        fail("unknown vault command")
    p = authenticate(st, flags, "vault")
    pool = p.writable(st) if flags.get("--permission") else p.vaults(st)
    out = []
    for v in pool:
        row = dict(v)
        row["items"] = sum(1 for i in st.data["items"] if i["vault"]["id"] == v["id"])
        out.append(row)
    emit(out)


def cmd_item(st, flags, args):
    global MALFORMED
    sub = args[0] if args else ""
    p = authenticate(st, flags, "item")
    MALFORMED = bool(st.data["flags"].get("malformed"))
    latency = st.data["flags"].get("latency_ms", 0)
    if latency:
        time.sleep(latency / 1000)
    if sub in ("list", "ls"):
        pool = visible_items(st, p)
        if flags.get("--vault"):
            v = find_vault(st, flags["--vault"], p.vaults(st))
            if not v:
                fail(f"\"{flags['--vault']}\" isn't a vault in this account.")
            pool = [i for i in pool if i["vault"]["id"] == v["id"]]
        if flags.get("--categories"):
            wanted = {CATEGORY_NAMES.get(c.strip().lower(), c.strip().upper().replace(" ", "_"))
                      for c in flags["--categories"].split(",")}
            pool = [i for i in pool if i["category"] in wanted]
        emit([summary(st, i) for i in pool])
        return
    if sub == "get":
        reveal = bool(flags.get("--reveal"))
        spec = args[1] if len(args) > 1 else None
        if spec == "-" or spec is None:
            specs = specs_from_stdin()
            for iid, vid in specs:
                item = find_item(st, p, iid, vid)
                emit(full(st, item, reveal))
            return
        if p.kind == "service" and not flags.get("--vault"):
            fail("When using service accounts, you must specify a vault with the '--vault' flag or through piped input.")
        item = find_item(st, p, spec, flags.get("--vault"))
        if flags.get("--otp"):
            otp = next((f for f in item.get("fields", []) if f["type"] == "OTP"), None)
            if not otp:
                fail(f"item \"{spec}\" does not contain a one-time password field")
            print(totp_code(otp["value"]))
            return
        emit(full(st, item, reveal))
        return
    if sub == "create":
        template = {}
        if len(args) > 1 and args[1] == "-":
            template = json.loads(read_stdin() or "{}")
        vault = find_vault(st, flags.get("--vault") or "Private", p.vaults(st))
        if not vault:
            fail(f"\"{flags.get('--vault')}\" isn't a vault in this account.")
        if vault["id"] not in {v["id"] for v in p.writable(st)}:
            fail("You do not have permission to perform this action.")
        fields = template_fields(template)
        category = (flags.get("--category") or template.get("category") or "LOGIN").upper()
        urls = template.get("urls") or ([{"label": "website", "primary": True, "href": flags["--url"]}]
                                        if flags.get("--url") else [])
        item = {
            "id": new_id(), "title": flags.get("--title") or template.get("title") or "Untitled",
            "version": 1, "vault": {"id": vault["id"]}, "category": category,
            "last_edited_by": p.account["user_uuid"] if p.account else pad("MOCKSERVICE", True),
            "created_at": now_iso(), "updated_at": now_iso(),
            "additional_information": username_of(fields), "urls": urls,
            "sections": template.get("sections") or [{"id": "add more"}], "fields": fields,
        }
        st.data["items"].append(item)
        st.save()
        emit(full(st, item, bool(flags.get("--reveal"))))
        return
    if sub == "edit":
        if len(args) < 2:
            fail("an item must be specified")
        item = find_item(st, p, args[1], flags.get("--vault"))
        if item["vault"]["id"] not in {v["id"] for v in p.writable(st)}:
            fail("You do not have permission to perform this action.")
        raw = read_stdin()
        if raw.strip():
            template = json.loads(raw)
            if "fields" in template:
                item["fields"] = template_fields(template, item.get("fields"))
            for key in ("title", "urls", "tags", "sections"):
                if key in template:
                    item[key] = template[key]
        if flags.get("--title"):
            item["title"] = flags["--title"]
        for a in args[2:]:
            if "=" in a:
                fail("the mock refuses assignment statements: Copper must send values through stdin")
        item["additional_information"] = username_of(item["fields"]) if item["category"] == "LOGIN" else item.get("additional_information", "")
        item["version"] = item.get("version", 1) + 1
        item["updated_at"] = now_iso()
        st.save()
        emit(full(st, item, bool(flags.get("--reveal"))))
        return
    fail(f"unknown command \"{sub}\" for \"op item\"")


def cmd_mock(st, args):
    sub = args[0] if args else "show"
    if sub == "reset":
        st.data = seed()
        st.save()
        print("reset")
    elif sub == "expire":
        for s in st.data["sessions"].values():
            s["expired"] = True
        st.data["app_sessions"] = {}
        st.save()
        print("expired")
    elif sub == "set":
        key, value = args[1], args[2]
        st.data["flags"][key] = json.loads(value) if value not in ("on", "off") else value == "on"
        st.save()
        print(json.dumps(st.data["flags"]))
    elif sub == "bulk":
        count = int(args[1]) if len(args) > 1 else 1500
        vaults = [VAULT_PRIVATE, VAULT_SHARED]
        names = ["Café", "Ünïcode 🔐", "日本語サイト", "Ελληνικά", "Plain", "Bank", "Mail"]
        for n in range(count):
            host = f"login.shop{n % 600}.com"
            urls = [f"https://{host}/login"]
            if n % 5 == 0:
                urls.append(f"https://www.shop{n % 600}.com")
            if n % 97 == 0:
                urls = []  # an item without any website
            user = f"user{n}+{names[n % len(names)].split()[0].lower()}@example.net"
            st.data["items"].append(login_item(
                pad(f"bulk{n:06d}"), f"{names[n % len(names)]} {n}", vaults[n % 2], user, f"bulk-pw-{n}", urls,
                totp=("otpauth://totp/Bulk?secret=JBSWY3DPEHPK3PXP" if n % 50 == 0 else None)))
        st.save()
        print(f"bulk {count}")
    elif sub == "check":
        title, user, password = args[1], args[2], args[3]
        hit = False
        for i in st.data["items"]:
            if i["title"] == title:
                f = {x.get("purpose"): x.get("value") for x in i.get("fields", [])}
                hit = hit or (f.get("USERNAME") == user and f.get("PASSWORD") == password)
        print(json.dumps(hit))
    else:
        def fp(v):
            return hashlib.sha256(v.encode()).hexdigest()[:10] if v else ""
        out = {
            "flags": st.data["flags"],
            "accounts": [a["email"] for a in st.data["accounts"]],
            "live_sessions": sum(1 for s in st.data["sessions"].values() if not s.get("expired")),
            "app_sessions": [k for k, v in st.data["app_sessions"].items() if v],
            "items": [{"title": i["title"], "vault": vault_ref(st, i["vault"]["id"])["name"],
                       "category": i["category"], "version": i.get("version"),
                       "user": username_of(i.get("fields", [])),
                       "password_sha256": fp(next((f.get("value", "") for f in i.get("fields", [])
                                                   if f.get("purpose") == "PASSWORD"), "")),
                       "urls": [u["href"] for u in i.get("urls", [])]} for i in st.data["items"]],
        }
        print(json.dumps(out, indent=2))


def main(argv):
    if argv[:1] == ["mock"]:
        with State() as st:
            cmd_mock(st, argv[1:])
        return 0
    stdin_len = 0
    log_call(argv, stdin_len)
    try:
        with open(state_path()) as f:
            early = json.load(f).get("flags", {})
    except (OSError, ValueError):
        early = {}
    if early.get("hang_ms"):
        time.sleep(early["hang_ms"] / 1000)
    flags, positional = parse(argv)
    if flags.get("--version") or flags.get("-v"):
        print(VERSION)
        return 0
    if os.environ.get("OP_CONFIG_DIR"):
        sys.stderr.write(f'Using configuration at non-standard location "{os.environ["OP_CONFIG_DIR"]}"\n')
    command = positional[0] if positional else ""
    args = positional[1:]
    try:
        with State() as st:
            if command == "account":
                cmd_account(st, flags, args)
            elif command == "signin":
                cmd_signin(st, flags)
            elif command == "signout":
                cmd_signout(st, flags)
            elif command == "whoami":
                cmd_whoami(st, flags)
            elif command == "vault":
                cmd_vault(st, flags, args)
            elif command == "item":
                cmd_item(st, flags, args)
            else:
                fail(f"unknown command \"{command}\" for \"op\"")
    except OpError as e:
        sys.stderr.write(f"[ERROR] {stamp()} {e}\n")
        return 1
    return 0


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
